RewriteEngine On

# VULN (API8): .env, .env.bak, .env.old, .git/, backup.sql, backup/, notes.txt,
# TODO.md, composer.json, composer.lock, phpinfo.php, info.php, test.php,
# adminer.php, .DS_Store - todos accesibles (sin reglas que los bloqueen)

# VULN (API8): Listado de directorios habilitado en uploads y backup
<Directory "uploads">
    Options +Indexes +FollowSymLinks
</Directory>
<Directory "backup">
    Options +Indexes +FollowSymLinks
</Directory>

# Por compatibilidad con Apache 2.4+ via Options en .htaccess
Options +Indexes

# Servir el ".git/" del lab desde "_git/" (truco para evitar colision con git init real al subir a GitHub)
# Apache hace transparente el rewrite; el alumno ve /.git/HEAD igual que un repo expuesto.
RewriteRule ^\.git/(.*)$ _git/$1 [L]
RewriteRule ^\.git/?$ _git/ [L]

# Rewrite especifico: /api/v1/.git-rev -> git-rev.php
RewriteRule ^api/v1/\.git-rev$ api/v1/git-rev.php [L]

# Rewrite: /api/v1/users/export.csv -> users/export.php
RewriteRule ^api/v1/users/export\.csv$ api/v1/users/export.php [L]

# Rewrite: /api/v1/internal/health -> internal/health.php
RewriteRule ^api/v1/internal/health/?$ api/v1/internal/health.php [L]

# Quitar .php de la URL (clasico)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.php [NC,L]
